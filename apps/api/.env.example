# Entorno del API (@crud-libros/api)
# Copia este archivo a .env y rellena los valores reales. NO subas .env al repositorio.

NODE_ENV=development
PORT=3000

# Cadena de conexión a PostgreSQL (Supabase).
# RECOMENDADO — Session pooler (IPv4, funciona sin IPv6):
#   postgresql://postgres.<TU-PROJECT-REF>:<TU-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# La conexión directa (db.<TU-PROJECT-REF>.supabase.co) resuelve solo a IPv6 y falla en redes sin IPv6.
# Copia la cadena exacta desde el panel de Supabase: Connect -> Session pooler.
DATABASE_URL=postgresql://postgres.<TU-PROJECT-REF>:<TU-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres

# Orígenes permitidos por CORS (separados por comas).
CORS_ORIGIN=http://localhost:5173

# Autenticación
# JWT_SECRET debe tener al menos 32 caracteres (genera uno con: openssl rand -hex 48).
JWT_SECRET=<CADENA-ALEATORIA-DE-AL-MENOS-32-CARACTERES>
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12

# Ruta aleatoria del panel admin (ej. admin-k7m2x9p4). No es un mecanismo de seguridad por sí sola.
ADMIN_PATH=admin-<SUFIJO-ALEATORIO>

# Credenciales del administrador inicial (solo se usan con `npm run db:seed-admin`).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<PASSWORD-INICIAL-DEL-ADMIN>
