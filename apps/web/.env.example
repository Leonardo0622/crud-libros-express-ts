# Entorno del frontend (@crud-libros/web)
# Copia este archivo a .env y ajusta los valores.

# URL base del API.
# - Desarrollo: déjalo vacío para usar el proxy de Vite ("/api" -> http://localhost:3000).
# - Producción: apunta a tu API desplegada, p. ej. https://tu-api.up.railway.app
VITE_API_URL=

# Ruta del panel de administración. Debe coincidir con ADMIN_PATH del API.
VITE_ADMIN_PATH=admin-<SUFIJO-ALEATORIO>
