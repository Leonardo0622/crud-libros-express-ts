{
  "name": "crud-libros",
  "version": "1.0.0",
  "private": true,
  "description": "Biblioteca CRUD - monorepo (API Express+TS, web React, tipos compartidos)",
  "license": "ISC",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @crud-libros/api",
    "dev:web": "npm run dev --workspace @crud-libros/web",
    "build": "npm run build --workspace @crud-libros/types && npm run build --workspace @crud-libros/api && npm run build --workspace @crud-libros/web",
    "build:types": "npm run build --workspace @crud-libros/types",
    "build:api": "npm run build --workspace @crud-libros/api",
    "build:web": "npm run build --workspace @crud-libros/web",
    "db:migrate": "npm run db:migrate --workspace @crud-libros/api",
    "db:seed-admin": "npm run db:seed-admin --workspace @crud-libros/api",
    "db:migrate:prod": "npm run db:migrate:prod --workspace @crud-libros/api",
    "start:api": "node apps/api/dist/index.js",
    "test": "npm run test --workspace @crud-libros/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
